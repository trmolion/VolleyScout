// Ресурсы Windows: иконка приложения и сведения о версии (свойства файла в Проводнике).
// Генерируется CMake из app.rc.in — версия берётся из project(VERSION …).
// Файл в UTF-8: компилятору ресурсов передаётся --codepage=65001 (см. CMakeLists.txt).
#include <winver.h>

IDI_ICON1 ICON "@VS_ICON_PATH@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041904B0"
        BEGIN
            VALUE "CompanyName",      "@VS_COMPANY@\0"
            VALUE "FileDescription",  "@VS_DESCRIPTION@\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@\0"
            VALUE "InternalName",     "VolleyScout\0"
            VALUE "LegalCopyright",   "GNU GPL v3\0"
            VALUE "OriginalFilename", "VolleyScout.exe\0"
            VALUE "ProductName",      "VolleyScout\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0419, 1200
    END
END
